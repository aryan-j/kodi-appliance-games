<UserControl x:Class="GameApplianceOverlay.Playnite.PlayniteOverlaySettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="420">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="12">
      <TextBlock FontSize="16" FontWeight="SemiBold" Text="Game Appliance Overlay" />
      <TextBlock Margin="0,4,0,14" Foreground="Gray" TextWrapping="Wrap"
                 Text="Playnite supplies game metadata and lifecycle actions to the shared overlay over a local named pipe." />
      <CheckBox Margin="0,4" IsChecked="{Binding Settings.Enabled, Mode=TwoWay}"
                Content="Enable the Playnite connector" />
      <CheckBox Margin="0,4" IsChecked="{Binding Settings.LaunchWithGame, Mode=TwoWay}"
                Content="Start the overlay host when a game starts" />
      <CheckBox Margin="0,4" IsChecked="{Binding Settings.ShowOnGameStart, Mode=TwoWay}"
                Content="Show the overlay immediately when a game starts" />
      <CheckBox Margin="0,4" IsChecked="{Binding Settings.SuspendGame, Mode=TwoWay}"
                Content="Suspend the game while the overlay is visible" />
      <CheckBox Margin="0,4,0,12" IsChecked="{Binding Settings.PreferIcon, Mode=TwoWay}"
                Content="Prefer Playnite's game icon as the logo" />
      <TextBlock FontWeight="SemiBold" Text="Overlay host path (optional)" />
      <TextBox Margin="0,4,0,0" Text="{Binding Settings.OverlayHostPath, UpdateSourceTrigger=PropertyChanged}" />
      <TextBlock Margin="0,5,0,0" Foreground="Gray" TextWrapping="Wrap"
                 Text="Leave empty to use the companion bundled beside this extension." />
    </StackPanel>
  </ScrollViewer>
</UserControl>
