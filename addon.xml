<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="plugin.program.appliance.games" name="Kodi Appliance Games" version="0.4.0" provider-name="Aryan">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
    </requires>
    <extension point="xbmc.python.pluginsource" library="addon.py">
        <provides>executable game</provides>
    </extension>
    <extension point="xbmc.service" library="service.py" start="login"/>
    <extension point="xbmc.addon.metadata">
        <summary lang="en_GB">Native PC game library for the Kodi appliance.</summary>
        <description lang="en_GB">Browse, inspect and launch locally installed PC games with native Kodi metadata and artwork.</description>
        <platform>windows</platform>
        <license>MIT</license>
        <assets>
            <icon>resources/media/icon.png</icon>
            <fanart>resources/media/fanart.jpg</fanart>
        </assets>
    </extension>
</addon>
